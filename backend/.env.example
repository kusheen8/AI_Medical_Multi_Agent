# Cloud LLM (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (required)
# Example:
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ai_medical?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Local LLM via Ollama (required for local agents)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma:4b

# App runtime (optional)
APP_ENV=development
LOG_LEVEL=INFO
