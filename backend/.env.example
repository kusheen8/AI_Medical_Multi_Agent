# ── Cloud LLM (Coordinator) ──
GROQ_API_KEY=your_groq_api_key_here
# Optional: override default model (default is llama3-8b-8192)
# GROQ_MODEL=llama3-70b-8192

# ── Database (required) ──
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=ai_medical
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=10

# ── Local LLM via Ollama (required for local agents) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma:4b

# ── App Runtime (optional) ──
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=AI Medical Multi-Agent
APP_VERSION=0.1.0

# ── Authentication (Phase 5) ──
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_AUTH=false

# ── CORS (Phase 5) ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Rate Limiting (Phase 5) ──
RATE_LIMIT_LOGIN=100
RATE_LIMIT_API=1000

# ── Field Encryption (Phase 5) ──
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
